{
  "name": "eduplanner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "cd backend && npm install && cd ../frontend && npm install",
    "start": "concurrently npm:start:*",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend && npm run dev",
    "test": "concurrently npm:test:*",
    "test:backend": "nyc mocha --recursive './backend/**/*.spec.ts'",
    "test:frontend": "nyc mocha --recursive './frontend/src/app/*.spec.ts'"
  },
  "author": "Kelly Diabagate",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "mocha": "^10.2.0"
  },
  "dependencies": {
    "@types/node": "20.5.7",
    "concurrently": "^8.2.1",
    "nyc": "^15.1.0",
    "typescript": "5.2.2"
  }
}
