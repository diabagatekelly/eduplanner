{
  "name": "eduplanner",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "install:all-packages": "cd backend && npm install && cd ../frontend/dashboard && npm install && cd ../frontend/dashboard/functions && npm install",
    "start": "concurrently npm:start:*",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend/dashboard && npm run dev",
    "test": "concurrently npm:test:*",
    "test:backend": "nyc mocha --recursive './backend/**/*.spec.js'",
    "test:frontend": "nyc mocha --recursive './frontend/dashboard/src/app/*.spec.ts'",
    "build:frontend": "cd frontend/dashboard && npm run build",
    "deploy:frontend": "cd frontend/dashboard && npm run deploy"
  },
  "author": "Kelly Diabagate",
  "license": "ISC",
  "devDependencies": {
    "mocha": "^10.2.0"
  },
  "dependencies": {
    "concurrently": "^8.2.1",
    "nyc": "^15.1.0"
  }
}